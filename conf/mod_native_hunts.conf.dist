# Native Hunts standard gameplay configuration.

NativeHunts.Enable = 1
NativeHunts.Debug = 0
NativeHunts.MinimumLevel = 10
# Completion XP = current-level next-level XP * 0.08 * this value * prey multiplier.
NativeHunts.XPMultiplier = 0.75

# Assignment geography. Local uses the established per-Huntmaster authored
# region allowlists. Continent uses the Huntmaster's gameplay continent. World
# permits every level-appropriate authored zone. Local is the normal default;
# a Huntmaster with no eligible local ground for the player's level refuses the
# assignment cleanly rather than widening the scope.
NativeHunts.AssignmentScope = Local

NativeHunts.Tracking.ProgressMin = 3
NativeHunts.Tracking.ProgressMax = 7
# Nearby members of the killer's group can receive independent tracking credit.
NativeHunts.GroupCreditRadius = 100.0

# Shared optional relics per active hunting-zone pool. The default is 60.
# 0 disables relic generation, spawning, interaction, and tracking awards while
# leaving historical collection records intact. Values above 200 are clamped to
# 200; negative values are treated as 0. Existing active pools retain their
# persisted locations until their last active or resumable Hunt ends.
NativeHunts.Relics.CountPerZone = 60
# Time spent examining a relic. This uses a normal interruptible WoW spellcast;
# movement or other cast interruption awards no progress. Set to 0 for the
# previous instant interaction.
NativeHunts.Relics.CollectionCastTimeMs = 3000

# Required Standard tracking ambushes are spaced evenly through progress.
# Set Count to 0 to disable them. The assigned prey escapes at the configured
# health percentage; killing or evading it does not skip the pending ambush.
NativeHunts.Ambush.Count = 2
NativeHunts.Ambush.HealthMultiplier = 4.0
NativeHunts.Ambush.EscapeHealthPercent = 50.0

# Elite Hunts unlock after this many completed Standard Hunts. Accepting an
# Elite consumes the daily allowance immediately, preventing abandon/reroll.
NativeHunts.Elite.RequiredStandardCompletions = 10
NativeHunts.Elite.DailyLimit = 1
NativeHunts.Elite.HealthMultiplier = 1.0
NativeHunts.Elite.DamageMultiplier = 1.0
NativeHunts.Elite.ArmorMultiplier = 1.0
NativeHunts.Elite.XPMultiplier = 1.0
NativeHunts.Elite.GoldMultiplier = 1.0
NativeHunts.Elite.SealMinimumLevel = 80
NativeHunts.Elite.SealsPerCompletion = 1
NativeHunts.Elite.EndgameRewardLevel = 80
NativeHunts.Elite.EndgameRewardMinItemLevel = 200
NativeHunts.Elite.EndgameRewardMaxItemLevel = 200
NativeHunts.Elite.RewardRequireUpgrade = 1
NativeHunts.Elite.RewardUpgradePoolPct = 0.70
NativeHunts.Elite.NoUpgradeBonusSeals = 1

# Huntmaster's Seal store. Cost = 0 disables a tier. Item-level bounds are
# normalized if configured in reverse order. The catalog is generated from the
# loaded item templates; Epic Heroic-tooltip and resilience items are excluded.
NativeHunts.SealStore.Tier1.Cost = 5
NativeHunts.SealStore.Tier1.MinItemLevel = 213
NativeHunts.SealStore.Tier1.MaxItemLevel = 219

NativeHunts.SealStore.Tier2.Cost = 10
NativeHunts.SealStore.Tier2.MinItemLevel = 226
NativeHunts.SealStore.Tier2.MaxItemLevel = 232

NativeHunts.SealStore.Tier3.Cost = 20
NativeHunts.SealStore.Tier3.MinItemLevel = 245
NativeHunts.SealStore.Tier3.MaxItemLevel = 251

NativeHunts.SealStore.Tier4.Cost = 30
NativeHunts.SealStore.Tier4.MinItemLevel = 264
NativeHunts.SealStore.Tier4.MaxItemLevel = 264

# Active-Hunt visual aura is intentionally absent: the installed generic
# Content Manager supports Item, CurrencyTypes, CurrencyCategory, and
# ItemExtendedCost DBC rows, but not Spell.dbc/SpellIcon.dbc managed content.
# Native Hunts will not hijack an unrelated stock spell.

NativeHunts.ReturnRift.Enable = 1
# Clamped to 1-120 seconds.
NativeHunts.ReturnRift.DurationSeconds = 120
# Arrival distance from the exact issuing managed Huntmaster, clamped to 1-10.
NativeHunts.ReturnRift.ArrivalDistance = 3.0
